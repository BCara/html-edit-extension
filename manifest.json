{
  // VibeRevise — edit the visible text of an HTML document, local or served
  // from your own network, and save it with the markup untouched.
  //
  // Chrome's manifest parser accepts // comments; they are stripped before the
  // JSON is read. Every permission below is here because a specific feature
  // cannot work without it — see the justification on each one.
  "manifest_version": 3,
  "name": "VibeRevise",
  "version": "0.15.1",
  "description": "Edit the visible text of an HTML document — local, or served from your own network — and save it without disturbing the markup.",

  "permissions": [
    // activeTab — granted only for the tab whose toolbar icon the user clicked,
    // and only until they navigate away. This is what lets the content script
    // read the current file:// document. Chosen instead of a host permission
    // (e.g. "file:///*") so the extension has no standing access to anything:
    // no click, no access.
    //
    // It is also the ONLY permission needed for an http(s) document served from
    // your own network. A content script's fetch carries the page's origin, so
    // re-reading the document it is running on — and PUTting it back, where the
    // server allows that — is an ordinary same-origin request. No host
    // permission is requested for http or https, and none is needed. Which
    // addresses count as "your own network" is decided in src/lib/origins.js.
    "activeTab",

    // scripting — the content script is injected on demand by chrome.scripting
    // when the user clicks the icon, rather than being declared in
    // "content_scripts" and auto-injected into every local file they open.
    // Same reasoning as above: nothing runs unless asked.
    "scripting",

    // downloads — Chrome cannot write back to a file:// path, so saving is a
    // download. Used with saveAs:true so the OS file dialog always opens and
    // the user chooses the destination (including, deliberately, the original
    // file). No download is ever started without the user pressing Save.
    "downloads",

    // storage — the name the user types, and whether comments are shown in
    // the document. Kept in this browser profile on this device. Nothing
    // about any document is ever stored.
    "storage"
  ],

  // Not requested up front, only asked for if it turns out to be needed.
  //
  // A content script cannot read the file it is running on: in Manifest V3 its
  // fetch() carries the PAGE's origin, and a file:// page is not allowed to
  // read file:// URLs. The read therefore has to happen in the service worker,
  // which needs host access to the file scheme.
  //
  // It is optional rather than required so that installing VibeRevise grants it
  // nothing. If the service worker turns out to need it, the popup asks for it
  // with a button and Chrome shows its own consent prompt. If it is refused, or
  // if the service worker cannot read file URLs at all, the extension falls
  // back to asking the user to choose the file — which needs no permission.
  //
  // The http and https entries are for AI, and only for AI. They exist so the
  // AI settings page can ask for the ONE address the user typed — their
  // provider's API, or a model on their own machine — at the moment they press
  // Save, with Chrome's own prompt naming that host. Nothing is granted at
  // install, nothing wider than that one host is ever requested, and forgetting
  // the key takes it back. They have to be listed this broadly because the
  // address is the user's choice, not ours.
  "optional_host_permissions": ["file:///*", "https://*/*", "http://*/*"],

  // Network: none, unless the user adds an AI key. Then, and only when they
  // press a button asking for a suggestion, the background worker sends the
  // words of the paragraphs involved to the address they chose. Nothing is
  // ever sent to VibeRevise.
  //
  // Reading local files ALSO requires the user to tick "Allow access to file
  // URLs" on chrome://extensions. That is a separate, user-granted toggle, not
  // a manifest permission; the popup detects when it is off and explains it.

  // AI settings: provider, model, key. An extension page because only an
  // extension page may ask for host permission, and so the key is never typed
  // into a document VibeRevise was injected into.
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "src/background.js"
  },

  "action": {
    "default_title": "VibeRevise",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
